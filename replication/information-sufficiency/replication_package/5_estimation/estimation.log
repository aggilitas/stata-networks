. 
. *----------------------------------------------------------------------------
. * 2. Unit roots in levels, once per variable
. *----------------------------------------------------------------------------
. * Every variable is tested on its levels 2016-2025: the first test observation
. * is 2017 with its lag in 2016. A corridor whose series does not move over
. * 2017-2025 or over 2016-2024 has no statistic and is left out; the corridors
. * left out are posted: constant over 2016-2025, and constant in one window only.
. local A ""

. tempname ur

. postfile `ur' str24 variable double(p_fisher_pp n_panels n_constant n_one_window) using "results/unit_roots.dta", replace
(file results/unit_roots.dta not found)

. foreach v of varlist export_* attr_* {
  2.     local half ""
  3.     if substr("`v'", 1, 5) == "attr_" local half "& source < target"
  4.     tempvar sdv sdy sdl
  5.     quietly bysort cid: egen double `sdv' = sd(cond(year >= 2016, `v', .))
  6.     quietly bysort cid: egen double `sdy' = sd(cond(year >= 2017, `v', .))
  7.     quietly bysort cid: egen double `sdl' = sd(cond(inrange(year, 2016, 2024), `v', .))
  8.     sort cid year
  9.     local ok "`sdy' > 0 & `sdl' > 0"
 10.     quietly count if year == 2016 & `ok' `half'
 11.     local npan = r(N)
 12.     quietly count if year == 2016 & `sdv' == 0 `half'
 13.     local ncon = r(N)
 14.     quietly count if year == 2016 & `sdv' > 0 & !(`ok') `half'
 15.     local none = r(N)
 16.     quietly xtunitroot fisher `v' if year >= 2017 & `ok' `half', pperron lags(1)
 17.     local p = r(p_P)
 18.     if missing(`p') {
 19.         display as error "`v': the unit-root test returned no p value"
 20.         exit 459
 21.     }
 22.     assert r(df_P) == 2 * `npan'
 23.     post `ur' ("`v'") (`p') (`npan') (`ncon') (`none')
 24.     drop `sdv' `sdy' `sdl'
 25.     display "`v': p = " %6.4f `p' " on `npan' corridors; left out: `ncon' constant, `none' constant in one window"
 26.     if substr("`v'", 1, 5) == "attr_" {
 27.         local a = substr("`v'", 6, .)
 28.         if `p' >= `alpha' {
 29.             gen double use_`a' = D.`v'
 30.             display "   attr_`a' enters as its yearly change"
 31.             * the yearly change is tested with the same test on 2016-2025 (the
.             * change in 2016 reads the recorded 2015 level)
.             quietly xtunitroot fisher use_`a' if year >= 2017 & source < target, pperron lags(1)
 32.             local pd = r(p_P)
 33.             if missing(`pd') {
 34.                 display as error "D.`v': the unit-root test returned no p value"
 35.                 exit 459
 36.             }
 37.             assert r(df_P) == 2 * `npan'
 38.             post `ur' ("D.`v'") (`pd') (`npan') (0) (0)
 39.             display "   D.`v': p = " %9.3e `pd'
 40.         }
 41.         else {
 42.             gen double use_`a' = `v'
 43.             display "   attr_`a' enters in levels"
 44.         }
 45.         local A "`A' use_`a'"
 46.     }
 47. }
