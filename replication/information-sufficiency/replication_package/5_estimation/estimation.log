. foreach a in prod fin elec {
  2.     import delimited using "../4_inputs/networks/attr_`a'.csv", clear varnames(1) asdouble stringcols(2 3)
  3.     confirm numeric variable source_value target_value
  4.     foreach c in source_value target_value {
  5.         local t : type `c'
  6.         if "`t'" == "float" {
  7.             display as error "../4_inputs/networks/attr_`a'.csv: `c' read as float"
  8.             exit 7
  9.         }
 10.     }
 11.     assert inrange(year, 2015, 2025)
 12.     assert source != target & !missing(source_value, target_value)
 13.     assert source_value > 0 & target_value > 0
 14.     gen byte inR = strpos(" `R' ", " " + source + " ") > 0 & strpos(" `R' ", " " + target + " ") > 0
 15.     assert inR
 16.     bysort year: egen long nRR = total(inR)
 17.     assert nRR == `nE'
 18.     quietly tabulate year
 19.     assert r(r) == 11
 20.     drop inR nRR
 21.     network_calc, type(attribute) subnet(single) name(attr_`a')
 22. }
