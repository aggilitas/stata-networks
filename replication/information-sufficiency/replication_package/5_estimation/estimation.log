*! network_calc 2.0.0
*! Main command for calculating network edge weights
*! Author: Necmi TALAY
*! Date: 2026-09-13

. foreach p in ftools reghdfe {
  2.     capture which `p'
  3.     if _rc {
  4.         display as error "`p' is not installed (ssc install `p')"
  5.         exit 111
  6.     }
  7. }

. 
. * ---- settings ----------------------------------------------------------------
. local R  "BE BG DE DK EE ES FR GR HR HU IT LT LV PL PT RO SE SI"

. local HS "41 42 43 50 51 52 53 54 56 57 58 59 60 61 62 63 64 65"

. local alpha 0.05

. local nR : word count `R'

. local nE = `nR' * (`nR' - 1)

. local nHS : word count `HS'

. * -----------------------------------------------------------------------------
. 
. *----------------------------------------------------------------------------
. * 1. Construction, one file per network
. *----------------------------------------------------------------------------
. foreach k of local HS {
  2.     import delimited using "../4_inputs/networks/export_`k'.csv", clear varnames(1) asdouble stringcols(2 3)
  3.     * whole euro values below the long limit are read as long, which holds
.     * them exactly; only float would lose digits
.     confirm numeric variable source_value target_value
  4.     foreach c in source_value target_value {
  5.         local t : type `c'
  6.         if "`t'" == "float" {
  7.             display as error "../4_inputs/networks/export_`k'.csv: `c' read as float"
  8.             exit 7
  9.         }
 10.     }
 11.     assert inrange(year, 2016, 2025)
 12.     assert source != target
 13.     assert !missing(source_value, target_value)
 14.     assert source_value >= 0 & source_value == target_value
 15.     gen byte inR  = strpos(" `R' ", " " + source + " ") > 0 & strpos(" `R' ", " " + target + " ") > 0
 16.     gen byte rest = target == "REST" & strpos(" `R' ", " " + source + " ") > 0
 17.     assert inR | rest
 18.     bysort year: egen long nRR = total(inR)
 19.     bysort year: egen long nREST = total(rest)
 20.     assert nRR == `nE' & nREST == `nR'                  // complete R mesh, one REST row per node
 21.     quietly tabulate year
 22.     assert r(r) == 10
 23.     drop inR rest nRR nREST
 24.     network_calc, type(flow) subnet(single) direction(outflow) name(export_`k')
 25. }
