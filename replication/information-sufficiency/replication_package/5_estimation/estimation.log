. *----------------------------------------------------------------------------
. * 3. Models: export_a on export_b and the controls, reghdfe
. *----------------------------------------------------------------------------
. tempname res

. postfile `res' str2 y_sector str2 x_sector str7 model ///
>     double(b_x se_x p_x b_prod se_prod p_prod b_fin se_fin p_fin ///
>            b_elec se_elec p_elec r2_within N N_clust) ///
>     using "results/screen_models.dta", replace
(file results/screen_models.dta not found)

. 
. local nm = 0

. foreach a of local HS {
  2.     foreach b of local HS {
  3.         if "`a'" == "`b'" continue
  4.         local x "export_`b'"
  5.         capture quietly reghdfe export_`a' `x' `A', absorb(cid) vce(cluster cid)
  6.         local rc = _rc
  7.         if `rc' == 1 exit 1                               // Break
  8.         foreach t in x prod fin elec {
  9.             local b_`t' = .
 10.             local s_`t' = .
 11.             local p_`t' = .
 12.         }
 13.         local r2   = .
 14.         local nobs = .
 15.         local ncl  = .
 16.         local model "failed"
 17.         if `rc' == 0 {
 18.             local model "reghdfe"
 19.             local df = e(df_r)
 20.             foreach v in `x' `A' {
 21.                 if "`v'" == "`x'" local t "x"
 22.                 else local t = substr("`v'", 5, .)
 23.                 capture local bb = _b[`v']
 24.                 if _rc local bb = .
 25.                 capture local ss = _se[`v']
 26.                 if _rc local ss = .
 27.                 * an omitted regressor keeps b, se and p missing
.                 if `ss' < . & `ss' > 0 {
 28.                     local b_`t' = `bb'
 29.                     local s_`t' = `ss'
 30.                     local p_`t' = 2 * ttail(`df', abs(`bb' / `ss'))
 31.                 }
 32.             }
 33.             local r2   = e(r2_within)
 34.             local nobs = e(N)
 35.             local ncl  = e(N_clust)
 36.         }
 37.         post `res' ("`a'") ("`b'") ("`model'") ///
>             (`b_x') (`s_x') (`p_x') (`b_prod') (`s_prod') (`p_prod') ///
>             (`b_fin') (`s_fin') (`p_fin') (`b_elec') (`s_elec') (`p_elec') ///
>             (`r2') (`nobs') (`ncl')
 38.         local ++nm
 39.     }
 40.     display "sector `a' done"
 41. }
