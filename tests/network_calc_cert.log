. frame networks_single {
.     split edge_id, parse("_") gen(node)
variables created as string: 
node1  node2
.     gen str12 pair = cond(node1 < node2, node1 + "|" + node2, ///
>                                      node2 + "|" + node1)
.     collapse (sum) w, by(year pair)
.     assert abs(w) < 1e-12
. }

. di as res "2b attribute: cancels along the reversed edge"
2b attribute: cancels along the reversed edge

. 
. *==============================================================
. * 3. Scaling the input leaves every weight alone
. *
. * Each template is built from ratios, so multiplying the whole
. * input by a positive constant must not move a single weight.
. * One constant above one and one below. Every total is also taken
. * within a period, so a factor that changes from one period to the
. * next, and is the same for every node within a period, moves
. * nothing either.
. *==============================================================
. 
. foreach c in 1000 0.001 period {
  2.     foreach spec in "flow single flowsgl" "flow multi flowdat" ///
>                     "interaction multi intdat" ///
>                     "attribute single attrsgl" {
  3.         local typ : word 1 of `spec'
  4.         local sub : word 2 of `spec'
  5.         local src : word 3 of `spec'
  6.         if "`src'" == "flowsgl" local dat "`flowsgl'"
  7.         if "`src'" == "flowdat" local dat "`flowdat'"
  8.         if "`src'" == "intdat"  local dat "`intdat'"
  9.         if "`src'" == "attrsgl" local dat "`attrsgl'"
 10.         local opt = cond("`sub'" == "multi", "feature(feature)", "")
 11.         local frm = "networks_single"
 12. 
.         tempfile base
 13.         frames reset
 14.         use "`dat'", clear
 15.         network_calc, type(`typ') subnet(`sub') `opt' name(w)
 16.         frame `frm': qui save "`base'", replace
 17. 
.         frames reset
 18.         use "`dat'", clear
 19.         if "`c'" == "period" {
 20.             qui gen double k = cond(year == 2018, 1000, ///
>                                cond(year == 2019, 0.001, 7))
 21.         }
 22.         else {
 23.             qui gen double k = `c'
 24.         }
 25.         qui replace source_value = source_value * k
 26.         qui replace target_value = target_value * k
 27.         if "`sub'" == "multi" {
 28.             qui replace source_size = source_size * k
 29.             qui replace target_size = target_size * k
 30.         }
 31.         drop k
 32.         network_calc, type(`typ') subnet(`sub') `opt' name(w)
 33.         frame `frm' {
 34.             rename w w_scaled
 35.             if "`frm'" == "networks_multi" {
 36.                 qui merge 1:1 year feature edge_id using "`base'", ///
>                     nogenerate
 37.             }
 38.             else {
 39.                 qui merge 1:1 year edge_id using "`base'", nogenerate
 40.             }
 41.             assert reldif(w_scaled, w) < 1e-12
 42.         }
 43.         local by = cond("`c'" == "period", "a factor per period", "`c'")
 44.         di as res "3 `typ' `sub': unchanged when scaled by `by'"
 45.     }
 46. }

